# ---- Add these to .env.local and to your Vercel/Railway environment variables ----
# Never commit real values: .env* files must stay in .gitignore.

NEXT_PUBLIC_SITE_URL=https://weeecentre.com

# Google Search Console (HTML-tag method — content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 — Admin → Data streams → Web → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_ENABLE_IN_DEV=false

# PostgreSQL
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Neon/Supabase (Vercel): pooled connection string ending in ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
PG_POOL_MAX=5

# Admin dashboard (/admin)
ADMIN_PASSWORD=
# 32+ random characters — generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Pickup map — your location
NEXT_PUBLIC_CENTRE_MAP_QUERY=WEEE Centre, Mihango, Embakasi, Nairobi, Kenya
NEXT_PUBLIC_CENTRE_ADDRESS=Mihango, Embakasi, off the Eastern Bypass, Nairobi
NEXT_PUBLIC_CENTRE_LAT=
NEXT_PUBLIC_CENTRE_LNG=
# Optional Maps Embed API key (free; restrict to weeecentre.com/*)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Collection days (0=Sun … 6=Sat)
NEXT_PUBLIC_PICKUP_DAYS=1,2,3,4,5

# Google Business Profile
NEXT_PUBLIC_GBP_PLACE_ID=
NEXT_PUBLIC_GBP_URL=
# Server-only key for showing reviews (Places API (New); billing required)
GOOGLE_PLACES_API_KEY=
GOOGLE_REVIEWS_REVALIDATE=3600
